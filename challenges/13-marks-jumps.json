    {
      "id": "marks-03",
      "title": "Slice to the mark",
      "description": "Drop the legacy columns, from here up to mark e, which sits on email. The commas have to stay right, so whole lines won't do.",
      "start_text": [
        "SELECT id, name, legacy_a,",
        "  legacy_b, legacy_c,",
        "  legacy_d, email, created_at",
        "FROM users",
        "WHERE active"
      ],
      "cursor_start": [1, 17],
      "goal": {
        "type": "buffer_equals",
        "value": ["SELECT id, name, email, created_at", "FROM users", "WHERE active"]
      },
      "par_keys": 3,
      "par_seconds": 6,
      "hint": "With a backtick the mark is charwise: it deletes from the cursor up to the mark's exact column.",
      "solution": "d`e",
      "teaches": ["d`"],
      "preset": {
        "marks": {
          "e": [3, 12]
        }
      }
    },
    {
      "id": "marks-04",
      "title": "Pin it first",
      "description": "The sdk artifact needs its checksum from the build log below. Every other TODO waits for another day. Copy the checksum here without losing your place.",
      "start_text": [
        "-- Release manifest: every artifact gets a checksum.",
        "local verify = require(\"release.verify\")",
        "local size = 4096",
        "",
        "verify(\"api.tar\", \"TODO\", size)",
        "verify(\"web.tar\", \"TODO\", size)",
        "verify(\"cli.tar\", \"TODO\", size)",
        "verify(\"docs.tar\", \"TODO\", size)",
        "verify(\"jobs.tar\", \"TODO\", size)",
        "verify(\"ui.tar\", \"TODO\", size)",
        "verify(\"sdk.tar\", \"TODO\", size)",
        "verify(\"site.tar\", \"TODO\", size)",
        "verify(\"core.tar\", \"TODO\", size)",
        "verify(\"auth.tar\", \"TODO\", size)",
        "",
        "-- Checksums come from the build log.",
        "local log = {",
        "  api = \"1f8ac10f23c5b5bc1167bda84b833e5c057a77d2\",",
        "  web = \"2c26b46b68ffc68ff99b453c1d30413413422d70\",",
        "  sdk = \"da39a3ee5e6b4b0d3255bfef95601890afd80709\",",
        "  cli = \"ee26b0dd4af7e749aa1a8ee3c10ae9923f618980\",",
        "}",
        "",
        "return log"
      ],
      "cursor_start": [11, 19],
      "goal": {
        "type": "buffer_equals",
        "value": [
          "-- Release manifest: every artifact gets a checksum.",
          "local verify = require(\"release.verify\")",
          "local size = 4096",
          "",
          "verify(\"api.tar\", \"TODO\", size)",
          "verify(\"web.tar\", \"TODO\", size)",
          "verify(\"cli.tar\", \"TODO\", size)",
          "verify(\"docs.tar\", \"TODO\", size)",
          "verify(\"jobs.tar\", \"TODO\", size)",
          "verify(\"ui.tar\", \"TODO\", size)",
          "verify(\"sdk.tar\", \"da39a3ee5e6b4b0d3255bfef95601890afd80709\", size)",
          "verify(\"site.tar\", \"TODO\", size)",
          "verify(\"core.tar\", \"TODO\", size)",
          "verify(\"auth.tar\", \"TODO\", size)",
          "",
          "-- Checksums come from the build log.",
          "local log = {",
          "  api = \"1f8ac10f23c5b5bc1167bda84b833e5c057a77d2\",",
          "  web = \"2c26b46b68ffc68ff99b453c1d30413413422d70\",",
          "  sdk = \"da39a3ee5e6b4b0d3255bfef95601890afd80709\",",
          "  cli = \"ee26b0dd4af7e749aa1a8ee3c10ae9923f618980\",",
          "}",
          "",
          "return log"
        ]
      },
      "par_keys": 14,
      "par_seconds": 22,
      "hint": "ma pins your spot before you leave, and `a brings you back to it. yi\" and vi\" work on a quoted string.",
      "solution": "ma20Gyi\"`avi\"p",
      "teaches": ["m"]
    },
