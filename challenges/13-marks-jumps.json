{
  "$schema": "./schema.json",
  "pack": "marks-jumps",
  "title": "Marks and Jumps",
  "description": "Stop counting lines: marks you set, the jumps Neovim remembers and the changes it tracks.",
  "order": 13,
  "authors": ["navasvarela"],
  "levels": [
    {
      "id": "marks-01",
      "title": "Bookmarked",
      "description": "A reviewer left mark r on the sample rate they're asking about. Go right to it.",
      "start_text": [
        "[server]",
        "host = \"0.0.0.0\"",
        "port = 8080",
        "workers = 4",
        "",
        "[tls]",
        "enabled = true",
        "cert = \"/etc/app/cert.pem\"",
        "key = \"/etc/app/key.pem\"",
        "",
        "[database]",
        "url = \"postgres://db/app\"",
        "pool_size = 10",
        "pool_timeout = 30",
        "statement_timeout = 5000",
        "",
        "[cache]",
        "backend = \"redis\"",
        "url = \"redis://cache/0\"",
        "ttl = 300",
        "",
        "[logging]",
        "level = \"info\"",
        "format = \"json\"",
        "sample_rate = 0.25",
        "output = \"/var/log/app.log\"",
        "",
        "[metrics]",
        "enabled = true",
        "interval = 60"
      ],
      "cursor_start": [1, 0],
      "goal": {
        "type": "cursor_at",
        "line": 25,
        "col": 14
      },
      "par_keys": 2,
      "par_seconds": 5,
      "hint": "A backtick and a mark name jumps to that exact line and column. :marks lists them.",
      "solution": "`r",
      "teaches": ["`"],
      "preset": {
        "marks": {
          "r": [25, 14]
        }
      }
    },
    {
