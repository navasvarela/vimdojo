    {
      "id": "marks-07",
      "title": "A mark in another file",
      "description": "Mark U is on the retry count in util.lua. Capital marks work across files, so go there from here and set it to 5.",
      "files": {
        "main.lua": ["local util = require('util')", "", "print(util.retries)"],
        "util.lua": [
          "local M = {}",
          "",
          "M.timeout = 30",
          "M.retries = 3",
          "M.backoff = 2",
          "",
          "return M"
        ]
      },
      "open": "main.lua",
      "cursor_start": [3, 0],
      "goal": {
        "type": "files_equal",
        "files": {
          "util.lua": [
            "local M = {}",
            "",
            "M.timeout = 30",
            "M.retries = 5",
            "M.backoff = 2",
            "",
            "return M"
          ]
        }
      },
      "par_keys": 4,
      "par_seconds": 6,
      "hint": "A capital mark remembers its file too: `U opens the file and lands on the mark.",
      "solution": "`Ur5",
      "teaches": ["`A"],
      "preset": {
        "commands": [
          "edit util.lua",
          "call cursor(4, 13)",
          "normal! mU",
          "keepalt edit main.lua",
          "call cursor(3, 1)",
          "clearjumps"
        ]
      }
    }
