{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "vimdojo challenge pack",
  "description": "A pack is an ordered group of levels. Packs are the single source of truth for both the Neovim plugin and the web demo.",
  "type": "object",
  "additionalProperties": false,
  "required": ["pack", "title", "order", "levels"],
  "properties": {
    "$schema": { "type": "string" },
    "pack": {
      "description": "Stable pack identifier, kebab-case.",
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "order": {
      "description": "Position of the pack in the curriculum. Pack N+1 unlocks when pack N is complete.",
      "type": "integer",
      "minimum": 1
    },
    "track": {
      "description": "Curriculum track. Tracks unlock independently; packs within a track unlock in order.",
      "enum": ["motions", "usage", "setup"],
      "default": "motions"
    },
    "levels": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/level" } }
  },
  "$defs": {
    "lines": {
      "description": "Buffer contents as an array of lines, without trailing newlines. Avoids newline ambiguity between Lua and JS.",
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "level": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "description",
        "cursor_start",
        "goal",
        "par_keys",
        "par_seconds",
        "hint",
        "solution",
        "teaches"
      ],
      "properties": {
        "id": {
          "description": "Globally unique level id. Progress is keyed by it, so never rename a published id.",
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "start_text": { "$ref": "#/$defs/lines" },
        "cursor_start": {
          "description": "[line, col]: 1-based line, 0-based byte column. Matches nvim_win_get_cursor().",
          "type": "array",
          "prefixItems": [{ "type": "integer", "minimum": 1 }, { "type": "integer", "minimum": 0 }],
          "minItems": 2,
          "maxItems": 2
        },
        "goal": { "$ref": "#/$defs/goal" },
        "par_keys": {
          "description": "Keystroke par. Should equal (or be very close to) the best known solution length.",
          "type": "integer",
          "minimum": 1
        },
        "par_seconds": { "type": "number", "exclusiveMinimum": 0 },
        "hint": { "type": "string", "minLength": 1 },
        "solution": {
          "description": "Reference solution in Vim key notation (e.g. \"ffdw\", \"ciwfoo<Esc>\"). Used only by tests, never shown to players.",
          "type": "string",
          "minLength": 1
        },
        "teaches": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "web_demo": {
          "description": "Include this level in the browser demo. Only set it for levels verified to behave identically in the CodeMirror Vim emulation.",
          "type": "boolean",
          "default": false
        },
        "requires": {
          "description": "Minimum Neovim version for levels that rely on newer defaults or APIs. Older versions show the level as unavailable and skip it for unlocking.",
          "type": "object",
          "additionalProperties": false,
          "required": ["nvim"],
          "properties": { "nvim": { "type": "string", "pattern": "^\\d+\\.\\d+(\\.\\d+)?$" } }
        },
        "options": {
          "description": "Options set like :set in the level's clean room before it starts, e.g. { \"shiftwidth\": 2 }.",
          "type": "object",
          "additionalProperties": { "type": ["string", "number", "boolean"] }
        },
        "preset": {
          "description": "State applied before the timer starts.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "registers": {
              "description": "Register contents. A string is charwise; an array of lines is linewise.",
              "type": "object",
              "propertyNames": { "pattern": "^[a-z0-9\"-]$" },
              "additionalProperties": {
                "oneOf": [{ "type": "string" }, { "$ref": "#/$defs/lines" }]
              }
            },
            "marks": {
              "description": "Buffer marks as [line, col] (1-based line, 0-based col).",
              "type": "object",
              "propertyNames": { "pattern": "^[a-z]$" },
              "additionalProperties": { "$ref": "#/$defs/position" }
            },
            "commands": {
              "description": "Ex commands run after the level is built, before the timer starts (splits, quickfix lists, a previous :s).",
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            }
          }
        },
        "files": {
          "description": "Workspace files for levels about files and windows: written to a fresh directory that becomes the working directory. Use instead of start_text.",
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)*$",
            "not": { "pattern": "(^|/)\\.\\.?(/|$)" }
          },
          "additionalProperties": { "$ref": "#/$defs/lines" }
        },
        "open": {
          "description": "The workspace file the level starts in. Its text is the level's start text; cursor_start applies to it.",
          "type": "string"
        }
      },
      "oneOf": [{ "required": ["start_text"] }, { "required": ["files", "open"] }]
    },
    "goal": {
      "oneOf": [
        { "$ref": "#/$defs/goal_buffer_equals" },
        { "$ref": "#/$defs/goal_cursor_at" },
        { "$ref": "#/$defs/goal_register_contains" },
        { "$ref": "#/$defs/goal_all_of" },
        { "$ref": "#/$defs/goal_config_probes" },
        { "$ref": "#/$defs/goal_files_equal" },
        { "$ref": "#/$defs/goal_layout" }
      ]
    },
    "goal_buffer_equals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "value"],
      "properties": { "type": { "const": "buffer_equals" }, "value": { "$ref": "#/$defs/lines" } }
    },
    "goal_cursor_at": {
      "description": "Cursor must be at [line, col] (1-based line, 0-based col). The buffer must be unchanged unless allow_edit is true.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "line", "col"],
      "properties": {
        "type": { "const": "cursor_at" },
        "line": { "type": "integer", "minimum": 1 },
        "col": { "type": "integer", "minimum": 0 },
        "allow_edit": { "type": "boolean", "default": false }
      }
    },
    "position": {
      "type": "array",
      "prefixItems": [{ "type": "integer", "minimum": 1 }, { "type": "integer", "minimum": 0 }],
      "minItems": 2,
      "maxItems": 2
    },
    "goal_register_contains": {
      "description": "A register holds exactly these lines. Set linewise to also require the register type.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "register", "value"],
      "properties": {
        "type": { "const": "register_contains" },
        "register": { "type": "string", "pattern": "^[a-z0-9\"-]$" },
        "value": { "$ref": "#/$defs/lines" },
        "linewise": { "type": "boolean" }
      }
    },
    "goal_all_of": {
      "description": "Every inner goal must hold at the same time.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "goals"],
      "properties": {
        "type": { "const": "all_of" },
        "goals": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/goal" } }
      }
    },
    "goal_config_probes": {
      "description": "Setup levels: the buffer is an init.lua. It is loaded in a sandboxed headless Neovim and must load without errors and pass every probe. Neovim only; never web_demo.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "probes"],
      "properties": {
        "type": { "const": "config_probes" },
        "probes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/probe" } }
      }
    },
    "probe_description": {
      "description": "Shown in the level header. Each kind has a default.",
      "type": "string",
      "minLength": 1
    },
    "probe": {
      "oneOf": [
        { "$ref": "#/$defs/probe_option" },
        { "$ref": "#/$defs/probe_keys" },
        { "$ref": "#/$defs/probe_filetype" },
        { "$ref": "#/$defs/probe_command" },
        { "$ref": "#/$defs/probe_source_twice" },
        { "$ref": "#/$defs/probe_extmarks_after" },
        { "$ref": "#/$defs/probe_lua" }
      ]
    },
    "probe_option": {
      "description": "An option has this value in a new buffer once the config has loaded.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name", "value"],
      "properties": {
        "kind": { "const": "option" },
        "description": { "$ref": "#/$defs/probe_description" },
        "name": { "type": "string", "minLength": 1 },
        "value": { "type": ["string", "number", "boolean"] }
      }
    },
    "probe_keys": {
      "description": "Typing keys in a fixture file leaves the editor in the expected state.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "keys", "expect"],
      "properties": {
        "kind": { "const": "keys" },
        "description": { "$ref": "#/$defs/probe_description" },
        "keys": {
          "description": "Key notation typed as the player would, so mappings apply. <leader> means the leader the config set.",
          "type": "string",
          "minLength": 1
        },
        "lines": {
          "description": "The fixture file's lines. Defaults to one empty line.",
          "$ref": "#/$defs/lines"
        },
        "cursor": {
          "description": "Where the cursor starts in the fixture file.",
          "$ref": "#/$defs/position"
        },
        "expect": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "lines": { "$ref": "#/$defs/lines" },
            "cursor": { "$ref": "#/$defs/position" },
            "modified": { "type": "boolean" },
            "hlsearch": {
              "description": "v:hlsearch: whether search matches are highlighted.",
              "type": "boolean"
            },
            "windows": {
              "description": "Windows in the current tab.",
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "probe_filetype": {
      "description": "A new buffer of this filetype gets these options.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "filetype", "expect"],
      "properties": {
        "kind": { "const": "filetype" },
        "description": { "$ref": "#/$defs/probe_description" },
        "filetype": { "type": "string", "minLength": 1 },
        "expect": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": ["string", "number", "boolean"] }
        }
      }
    },
    "probe_command": {
      "description": "An Ex command turns the fixture lines into the expected lines.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "command", "lines", "expect"],
      "properties": {
        "kind": { "const": "command" },
        "description": { "$ref": "#/$defs/probe_description" },
        "command": {
          "description": "Without the colon, e.g. \"Trim\" or \"%Trim\".",
          "type": "string",
          "minLength": 1
        },
        "lines": { "$ref": "#/$defs/lines" },
        "expect": { "$ref": "#/$defs/lines" }
      }
    },
    "probe_source_twice": {
      "description": "Sourcing the config a second time doesn't add autocommands for this event.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "event"],
      "properties": {
        "kind": { "const": "source_twice" },
        "description": { "$ref": "#/$defs/probe_description" },
        "event": { "type": "string", "minLength": 1 }
      }
    },
    "probe_extmarks_after": {
      "description": "Typing keys in a fixture file leaves extmarks behind (e.g. the yank highlight).",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "keys"],
      "properties": {
        "kind": { "const": "extmarks_after" },
        "description": { "$ref": "#/$defs/probe_description" },
        "keys": {
          "description": "Key notation typed as the player would, so mappings apply. <leader> means the leader the config set.",
          "type": "string",
          "minLength": 1
        },
        "lines": {
          "description": "The fixture file's lines. Defaults to one empty line.",
          "$ref": "#/$defs/lines"
        },
        "cursor": {
          "description": "Where the cursor starts in the fixture file.",
          "$ref": "#/$defs/position"
        },
        "namespace": {
          "description": "Only count this namespace. Omit to count all, which survives renames between Neovim versions.",
          "type": "string",
          "minLength": 1
        },
        "min": { "type": "integer", "minimum": 1, "default": 1 }
      }
    },
    "probe_lua": {
      "description": "Escape hatch: a Lua expression that must evaluate to true. Prefer a declarative probe.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "expr", "description"],
      "properties": {
        "kind": { "const": "lua" },
        "description": { "$ref": "#/$defs/probe_description" },
        "expr": { "type": "string", "minLength": 1 }
      }
    },
    "goal_files_equal": {
      "description": "Workspace files hold exactly these lines (unsaved buffer edits count).",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "files"],
      "properties": {
        "type": { "const": "files_equal" },
        "files": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "pattern": "^[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)*$" },
          "additionalProperties": { "$ref": "#/$defs/lines" }
        }
      }
    },
    "goal_layout": {
      "description": "The current tab's windows, as winlayout() with workspace file names in the leaves.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "layout"],
      "properties": { "type": { "const": "layout" }, "layout": { "$ref": "#/$defs/layout_node" } }
    },
    "layout_node": {
      "oneOf": [
        {
          "type": "array",
          "prefixItems": [
            { "const": "leaf" },
            { "type": "string", "pattern": "^[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)*$" }
          ],
          "minItems": 2,
          "maxItems": 2
        },
        {
          "type": "array",
          "prefixItems": [
            { "enum": ["row", "col"] },
            { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/layout_node" } }
          ],
          "minItems": 2,
          "maxItems": 2
        }
      ]
    }
  }
}
