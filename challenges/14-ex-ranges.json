        "  at start (cli.js:3)",
        "",
        "Node v22"
      ],
      "cursor_start": [1, 0],
      "goal": {
        "type": "buffer_equals",
        "value": [
          "Traceback, newest call first:",
          "",
          "  at start (cli.js:3)",
          "  at boot (main.js:9)",
          "  at load (loader.js:17)",
          "  at compile (view.js:41)",
          "  at render (view.js:88)",
