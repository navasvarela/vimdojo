    {
      "id": "ex-ranges-06",
      "title": "Between the marks",
      "description": "Marks a and b bracket the helpers. Change require to lazy on those lines only, from where you are.",
      "start_text": [
        "// Bundle entry. Only the helpers load lazily.",
        "var version = \"1.2\";",
        "var debug = require(\"debug\");",
        "",
        "function boot() {",
        "  var started = now();",
        "  return started;",
        "}",
        "",
        "// helpers",
        "var path = require(\"path\");",
        "var fs = require(\"fs\");",
        "var os = require(\"os\");",
        "var util = require(\"util\");",
        "var zlib = require(\"zlib\");",
        "// end helpers",
        "",
        "var cache = require(\"cache\");",
        "var queue = [];",
        "",
        "boot();"
      ],
      "cursor_start": [2, 0],
      "goal": {
        "type": "buffer_equals",
        "value": [
          "// Bundle entry. Only the helpers load lazily.",
          "var version = \"1.2\";",
          "var debug = require(\"debug\");",
          "",
          "function boot() {",
          "  var started = now();",
          "  return started;",
          "}",
          "",
          "// helpers",
          "var path = lazy(\"path\");",
          "var fs = lazy(\"fs\");",
          "var os = lazy(\"os\");",
          "var util = lazy(\"util\");",
          "var zlib = lazy(\"zlib\");",
          "// end helpers",
          "",
          "var cache = require(\"cache\");",
          "var queue = [];",
          "",
          "boot();"
        ]
      },
      "par_keys": 19,
      "par_seconds": 28,
      "hint": "Marks are addresses. 'a,'b is every line from one mark to the other.",
      "solution": ":'a,'bs/re\\w*/lazy<CR>",
      "teaches": [":'a,'b"],
      "preset": {
        "marks": {
          "a": [11, 0],
          "b": [15, 0]
        }
      }
    },
