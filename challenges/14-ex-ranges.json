    {
      "id": "ex-ranges-08",
      "title": "Only the listed files",
      "description": "Rename getUser to fetchUser in the files on the argument list, which :args shows. legacy.lua is open as well, and has to stay frozen.",
      "files": {
        "api.lua": [
          "local api = {}",
          "local target = 'v2'",
          "function api.me(s) return getUser(s.id) end",
          "return api"
        ],
        "admin.lua": ["local u = getUser(1)", "if u.admin then", "  getUser(2).promote()", "end"],
        "cli.lua": ["print(getUser(arg[1]).name)"],
        "legacy.lua": ["-- Frozen until the v1 clients are gone.", "return getUser(0)"]
      },
      "open": "api.lua",
      "cursor_start": [1, 0],
      "goal": {
        "type": "files_equal",
        "files": {
          "api.lua": [
            "local api = {}",
            "local target = 'v2'",
            "function api.me(s) return fetchUser(s.id) end",
            "return api"
          ],
          "admin.lua": [
            "local u = fetchUser(1)",
            "if u.admin then",
            "  fetchUser(2).promote()",
            "end"
          ],
          "cli.lua": ["print(fetchUser(arg[1]).name)"],
          "legacy.lua": ["-- Frozen until the v1 clients are gone.", "return getUser(0)"]
        }
      },
      "par_keys": 22,
      "par_seconds": 32,
      "hint": ":argdo runs a command in each file on the list. :bufdo would reach legacy.lua too.",
      "solution": ":argdo %s/getU/fetchU<CR>",
      "teaches": [":argdo"],
      "preset": {
        "commands": ["args api.lua admin.lua cli.lua", "badd legacy.lua"]
