    {
      "id": "ex-ranges-03",
      "title": "Copy, then change",
      "description": "Every GET route also needs a HEAD route right below it. Same path, same handler.",
      "start_text": [
        "const router = express.Router()",
        "",
        "router.get(\"/users\", listUsers)",
        "router.post(\"/users\", createUser)",
        "router.get(\"/budget\", getBudget)",
        "router.put(\"/budget\", setBudget)",
        "router.delete(\"/users/:id\", removeUser)",
        "router.get(\"/health\", health)",
        "router.post(\"/login\", login)",
        "router.get(\"/reports\", listReports)",
        "",
        "module.exports = router"
      ],
      "cursor_start": [1, 0],
      "goal": {
        "type": "buffer_equals",
        "value": [
          "const router = express.Router()",
          "",
          "router.get(\"/users\", listUsers)",
          "router.head(\"/users\", listUsers)",
          "router.post(\"/users\", createUser)",
          "router.get(\"/budget\", getBudget)",
          "router.head(\"/budget\", getBudget)",
          "router.put(\"/budget\", setBudget)",
          "router.delete(\"/users/:id\", removeUser)",
          "router.get(\"/health\", health)",
          "router.head(\"/health\", health)",
          "router.post(\"/login\", login)",
          "router.get(\"/reports\", listReports)",
          "router.head(\"/reports\", listReports)",
          "",
          "module.exports = router"
        ]
      },
      "par_keys": 20,
      "par_seconds": 30,
      "hint": ":g can chain commands with |. After :t. the cursor is on the copy, and an empty :s pattern reuses the last search.",
      "solution": ":g/get(/t.|s//head(<CR>",
      "teaches": [":t.|s"]
    },
    {
      "id": "ex-ranges-04",
      "title": "Block by block",
      "description": "Delete the generated blocks, BEGIN and END lines included. They're all different lengths.",
      "start_text": [
        "FROM alpine",
        "# LOGIN to the REGISTRY first",
        "# BEGIN generated",
        "ENV A=1",
        "RUN make",
        "# END generated",
        "WORKDIR /app",
        "RUN gen",
        "# BEGIN generated",
        "ADD gen/ .",
        "# END generated",
        "RUN make",
        "# BEFORE shipping, run the tests",
        "USER app",
        "# BEGIN generated",
        "# BUNDLE everything",
        "ENV B=2",
        "ENV C=3",
        "ADD gen/ .",
        "# END generated",
        "CMD [\"app\"]"
      ],
      "cursor_start": [1, 0],
      "goal": {
        "type": "buffer_equals",
        "value": [
          "FROM alpine",
