      },
      "par_keys": 15,
      "par_seconds": 22,
      "hint": "The command :g runs can have its own range, starting at each match: ,/pattern/ runs to the next line matching it.",
      "solution": ":g/BEG/,/END/d<CR>",
      "teaches": [":g/a/,/b/"]
    },
    {
      "id": "ex-ranges-05",
      "title": "Up one line",
      "description": "House style puts else on the same line as the closing brace. Fix all of them.",
      "start_text": [
        "int parse(const char *s) {",
        "  // errors are handled elsewhere",
        "  if (s == NULL) {",
        "    return -1;",
        "  }",
        "  else if (*s == 0) {",
        "    return 0;",
        "  }",
        "  else {",
        "    flag = false || check(s);",
        "  }",
        "  err = flag;",
        "  elapsed = now();",
        "  if (err) {",
        "    exit(1);",
        "  }",
        "  else {",
        "    log_ok(elapsed);",
        "  }",
        "  return 1;",
        "}"
      ],
      "cursor_start": [1, 0],
      "goal": {
        "type": "buffer_equals",
        "value": [
          "int parse(const char *s) {",
          "  // errors are handled elsewhere",
          "  if (s == NULL) {",
          "    return -1;",
          "  } else if (*s == 0) {",
          "    return 0;",
          "  } else {",
          "    flag = false || check(s);",
          "  }",
          "  err = flag;",
          "  elapsed = now();",
          "  if (err) {",
