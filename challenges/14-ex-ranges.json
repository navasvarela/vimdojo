    {
      "id": "ex-ranges-02",
      "title": "Round up the TODOs",
      "description": "Copy every TODO comment to the end of the file, under Follow-ups, leaving the originals where they are.",
      "start_text": [
        "def charge(order):",
        "    # TODO retry on timeout",
        "    token = fetch_token()",
        "    # TOKEN refresh is DONE elsewhere",
        "    return gateway.pay(order, token)",
        "",
        "def refund(order):",
        "    # NO retry here: UNDO the charge",
        "    # TODO log the reason",
        "    gateway.void(order)",
        "",
        "ODOMETER_KM = 3",
        "",
        "def report():",
        "    # TODAY only, for now",
        "    # TODO add the weekly totals",
        "    return METHOD.run()",
        "",
        "# Follow-ups"
      ],
      "cursor_start": [1, 0],
      "goal": {
