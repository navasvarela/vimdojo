      "title": "Upside down",
      "description": "This stack trace reads newest first. Reverse its five lines so the oldest call comes first.",
      "start_text": [
        "Traceback, newest call first:",
        "",
        "  at render (view.js:88)",
        "  at compile (view.js:41)",
        "  at load (loader.js:17)",
