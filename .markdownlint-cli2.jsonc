{
  // A soft lint, for real mistakes rather than style. Drafts and tables in this
  // repo are long-lined and use inline HTML on purpose.
  "config": {
    "default": true,
    "MD013": false, // line length
    "MD033": false, // inline HTML
    "MD041": false, // first line must be a heading
    "MD024": { "siblings_only": true }, // repeated headings under different parents
    "MD060": false // table column style
  },
  "globs": ["**/*.md"],
  "ignores": ["**/node_modules/**", ".deps/**", "web/dist/**"]
}
