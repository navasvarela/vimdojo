{
  "name": "vimdojo-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "typecheck": "tsc --noEmit",
    "lint": "biome ci --error-on-warnings ..",
    "fix": "biome check --write .."
  },
  "dependencies": {
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@replit/codemirror-vim": "6.4.0",
    "codemirror": "6.0.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "26.6.5",
    "@vitest/browser-playwright": "5.0.5",
    "jsdom": "30.1.3",
    "playwright": "1.64.1",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
