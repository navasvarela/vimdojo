# Records docs/demo.gif for the README: `make gif` (needs vhs).
Output docs/demo.gif

Require nvim

Set Shell "bash"
Set FontSize 20
Set Width 1200
Set Height 840
Set Padding 24
Set Theme "GruvboxDark"
Set TypingSpeed 220ms

Hide
Type "nvim -u scripts/demo_init.lua" Enter
Sleep 1s
Show

Type ":VimDojo"
Sleep 400ms
Enter
Sleep 1.8s
Enter
Sleep 2.2s
Type "jjjll"
Sleep 3.5s
Type "n"
Sleep 2.2s
Type "wwwww"
Sleep 3.5s
